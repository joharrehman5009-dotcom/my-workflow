capture/out/frames/
capture/out/frames-local/
capture/out/frames-diff/
capture/out/shots/

# Scratch renders
capture/out/_baseline.html
*.log

# Separate project, not part of this one
capture/fuch/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
